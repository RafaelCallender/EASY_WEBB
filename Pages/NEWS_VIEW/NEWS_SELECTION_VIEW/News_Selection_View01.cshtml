@page
@model EASYPROJECT01.EASY_WEBB.Pages.NEWS_VIEW.NEWS_SELECTION_VIEW.News_Selection_View01
@{
    Layout = null;
}

<link href="~/css/site01.css" rel="stylesheet" />

<div class="halftone">
    <h1>EASY CALLENDER</h1>
    <div class="tagline">
        💥 Easy callender projects 💥
    </div>
   <form method="post">
        <div class="contact-card">
            <label>Select Project</label>
            <select asp-for="News_View_M01.SelectedProject" asp-items="Model.News_View_M01.ProjectOptions"
                    class="form-control" onchange="this.form.submit()">
                <option value="">-- Select Project --</option>
            </select>
        </div>
        <div class="status-label">
            @Model.News_View_M01.StatusMessage01
        </div>
        @if (Model.News_View_M01.ShowInput01)
        {
            <div class="contact-card">
                <label>@Model.News_View_M01.label01</label>
                <input asp-for="News_View_M01.input01" required />
            </div>

        }
        <div class="status-label">
            @Model.News_View_M01.StatusMessage02
        </div>

        <div class="cta">
            <button type="submit" asp-page-handler="ok">
                ⚡ OK ⚡
            </button>
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="back">
                ⚡ BACK ⚡
            </button>
        </div>
    </form>
    <footer>
        © 2026 EASY CALLENDER
    </footer>
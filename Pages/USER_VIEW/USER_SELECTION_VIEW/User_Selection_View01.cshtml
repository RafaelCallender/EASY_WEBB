@page
@model EASYPROJECT01.EASY_WEBB.Pages.USER_VIEW.USER_SELECTION_VIEW.User_Selection_View01
@{
    Layout = null;
}
<!-- LINK TO YOUR CSS -->

<link href="~/css/site01.css" rel="stylesheet" />
<div class="halftone">
    <h1>EASY CALLENDER</h1>
    <div class="tagline">
        💥 Easy callender projects 💥
    </div>
    <form method="post">
        <div class="contact-card">
            <label>Select Project</label>
            <select asp-for="User_View_M01.SelectedProject" asp-items="Model.User_View_M01.ProjectOptions"
                    class="form-control" onchange="this.form.submit()">

                <option value="">-- Select Project --</option>
            </select>
        </div>
        @if (Model.User_View_M01.ShowInput01)
        {
            <div class="contact-card">
                <label>@Model.User_View_M01.label01</label>
                <input asp-for="User_View_M01.input01" required />
            </div>

        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage01
        </div>
        @if (Model.User_View_M01.ShowInput02)
        {
            <div class="contact-card">
                <label>@Model.User_View_M01.label02</label>
                <input asp-for="User_View_M01.input02" required />
            </div>

        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage02
        </div>

        @if (Model.User_View_M01.ShowInput03)
        {
            <div class="contact-card">
                <label>@Model.User_View_M01.label03</label>
                <input asp-for="User_View_M01.input03" required />
            </div>

        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage03
        </div>
        @if (Model.User_View_M01.ShowInput04)
        {
            <div class="contact-card">
                <label>Date of Birth</label>
                <input asp-for="User_View_M01.SelectedDate" type="date" class="form-control" />
            </div>
        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage04
        </div>
        @if (Model.User_View_M01.ShowInput05)
        {
            <div class="contact-card">
                <label>@Model.User_View_M01.label04</label>
                <input asp-for="User_View_M01.input04" required />
            </div>

        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage05
        </div>
        @if (Model.User_View_M01.ShowInput06)
        {
            <div class="contact-card">
                <label>@Model.User_View_M01.label05</label>
                <input asp-for="User_View_M01.input05" required />
            </div>

        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage06
        </div>
        @if (Model.User_View_M01.ShowInput07)
        {
            <div class="contact-card">
                <label>@Model.User_View_M01.label06</label>
                <input asp-for="User_View_M01.input06" required />
            </div>

        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage07
        </div>
        @if (Model.User_View_M01.ShowInput08)
        {
            <div class="contact-card">
                <label>@Model.User_View_M01.label07</label>
                <input asp-for="User_View_M01.input07" required />
            </div>

        }
        <div class="status-label">
            @Model.User_View_M01.StatusMessage08
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="ok">
                ⚡ OK ⚡
            </button>
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="back">
                ⚡ BACK ⚡
            </button>
        </div>
    </form>
    <footer>
        © 2026 EASY CALLENDER
    </footer>
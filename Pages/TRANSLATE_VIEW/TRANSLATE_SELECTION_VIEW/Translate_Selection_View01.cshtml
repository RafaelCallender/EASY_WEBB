@page
@model EASYPROJECT01.EASY_WEBB.Pages.TRANSLATE_VIEW.TRANSLATE_SELECTION_VIEW.Translate_Selection_View01
@{
    Layout = null;
}
<!-- LINK TO YOUR CSS -->
<link href="~/css/site01.css" rel="stylesheet" />
<div class="halftone">
    <h1>EASY CALLENDER</h1>
    <div class="tagline">
        💥 Easy callender projects 💥
    </div>
    <form method="post">

        <div class="contact-card">
            <label>Select Project</label>
            <select asp-for="Translate_View_M01.SelectedProject" asp-items="Model.Translate_View_M01.ProjectOptions"
                    class="form-control" onchange="this.form.submit()">
                <option value="">-- Select Project --</option>
            </select>
        </div>

        @if (Model.Translate_View_M01.ShowInput01)
        {
            <div class="contact-card">
                <label>@Model.Translate_View_M01.label01</label>
                <input asp-for="Translate_View_M01.input01" />
            </div>
        }

        @if (Model.Translate_View_M01.ShowInput02)
        {
            <div class="contact-card">
                <label>Select language</label>

                <select asp-for="Translate_View_M01.SelectedProject01" asp-items="Model.Translate_View_M01.ProjectOptions01"
                        class="form-control">
                    <option value="">Select language</option>
                </select>
            </div>
        }
        <div class="status-label">
            @Model.Translate_View_M01.StatusMessage01
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="ok">
                ⚡ OK ⚡
            </button>
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="back">
                ⚡ BACK ⚡
            </button>
        </div>
    </form>
    <footer>
        © 2026 EASY CALLENDER
    </footer>
@page
@model EASYPROJECT01.EASY_WEBB.Pages.JOURNAL_VIEW.JOURNAL_SELECTION_VIEW.Journal_Selection_View01
@{
    Layout = null;
}
<!-- LINK TO YOUR CSS -->

<link href="~/css/site01.css" rel="stylesheet" />
<div class="halftone">
    <h1>EASY CALLENDER</h1>
    <div class="tagline">
        💥 Easy callender projects 💥
    </div>
    <form method="post">
        @if (Model.Journal_View_M01.ShowInput01)
        {
            <div class="contact-card">
                <label>Select Project</label>
                <select asp-for="Journal_View_M01.SelectedProject" asp-items="Model.Journal_View_M01.ProjectOptions"
                        class="form-control" onchange="this.form.submit()">
                    <option value="">-- Select Project --</option>
                </select>
            </div>
        }
        @if (Model.Journal_View_M01.ShowInput02)
        {
            <div class="contact-card">
                <label>@Model.Journal_View_M01.label01</label>
                <input asp-for="Journal_View_M01.input01" required />
            </div>

        }
        <div class="status-label">
            @Model.Journal_View_M01.StatusMessage01
        </div>
        @if (Model.Journal_View_M01.ShowInput03)
        {
            <div class="cta">
                <button type="submit" asp-page-handler="ok">
                    ⚡ OK ⚡
                </button>
            </div>
        }
        <div class="status-label">
            @Model.Journal_View_M01.StatusMessage02
        </div>
        <div class="cta">
            <form method="post">
                <button type="submit" asp-page-handler="back">
                    ⚡ BACK ⚡
                </button>
            </form>
        </div>
    </form>
    <footer>
        © 2026 EASY CALLENDER
    </footer>
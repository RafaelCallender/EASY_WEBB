@page
@model EASYPROJECT01.EASY_WEBB.Pages.DOCUMENT_VIEW.DOCUMENT_SELECTION_VIEW.Document_Selection_View01
@{
    Layout = null;
}

<link href="~/css/site01.css" rel="stylesheet" />

<div class="halftone">

    ```
    <h1>EASY CALLENDER</h1>

    <div class="tagline">
        💥 Easy callender projects 💥
    </div>

    <form method="post" enctype="multipart/form-data">

        <div class="contact-card">
            <label>Select Project</label>

            <select asp-for="Document_View_M01.SelectedProject" asp-items="Model.Document_View_M01.ProjectOptions"
                    class="form-control" onchange="this.form.submit()">

                <option value="">-- Select Project --</option>

            </select>
        </div>
        
        @if (Model.Document_View_M01.ShowInput01)
        {
            <div class="contact-card">
                <label>@Model.Document_View_M01.label01</label>

                <input asp-for="Document_View_M01.input01" required />
            </div>
        }

        @if (Model.Document_View_M01.ShowInput02)
        {
            <div class="contact-card">
                <label>Select Image</label>
                <input type="file" asp-for="Document_View_M01.Upload" accept=".pdf,application/pdf" *" />
            </div>
        }
        <div class="status-label">
            @Model.Document_View_M01.StatusMessage01
        </div>

        @if (Model.Document_View_M01.ShowInput03)
        {
            <div class="cta">
                <button type="submit" asp-page-handler="ok">
                    ⚡ OK ⚡
                </button>
            </div>
        }


        <div class="cta">
            <button type="submit" asp-page-handler="back">
                ⚡ BACK ⚡
            </button>
        </div>
    </form>
    <footer>
        © 2026 EASY CALLENDER
    </footer>  
</div>

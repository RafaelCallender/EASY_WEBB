@page
@model EASYPROJECT01.EASY_WEBB.Pages.AI_VIEW.AI_SELECTION_VIEW.Ai_Selection_View04
@{
    Layout = null;
}
<!-- LINK TO YOUR CSS -->
<link href="@Url.Content(Model.css01)" rel="stylesheet" />
<div class="halftone">
    <h1>EASY CALLENDER</h1>
    <div class="tagline">
        💥 Easy callender projects 💥
    </div>
    <form method="post">
        <div class="contact-card">
            <label>Select Project</label>
            <select asp-for="Ai_View_M01.SelectedProject" asp-items="Model.Ai_View_M01.ProjectOptions"
                    class="form-control" onchange="this.form.submit()">
                <option value="">-- Select Project --</option>
            </select>
        </div>
        <div class="status-label">
            @Model.Ai_View_M01.StatusMessage01
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="ok">
                ⚡ OK ⚡
            </button>
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="back">
                ⚡ BACK ⚡
            </button>
        </div>
    </form>
</div>
<footer>
    © 2026 EASY CALLENDER
</footer>
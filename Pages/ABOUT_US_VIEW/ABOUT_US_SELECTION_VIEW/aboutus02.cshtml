@page
@model EASYPROJECT01.EASY_WEBB.Pages.ABOUT_US_VIEW.ABOUT_US_SELECTION_VIEW.aboutus02
@{
    Layout = null;
}
<link href="~/css/site01.css" rel="stylesheet" />
<div class="halftone">
    <h1>EASY CALLENDER</h1>
    <div class="tagline">
        💥 Easy callender projects 💥
    </div>
    <form method="post">
        @if (Model.About_View_M01.ShowInput01)
        {
            <div class="contact-card">
                <label>Select Project</label>
                <select asp-for="About_View_M01.SelectedProject" asp-items="Model.About_View_M01.ProjectOptions"
                        class="form-control" onchange="this.form.submit()">
                    <option value="">-- Select Project --</option>
                </select>
            </div>
        }
        @if (Model.About_View_M01.ShowInput02)
        {
            <div class="contact-card">
                <label>@Model.About_View_M01.label01</label>
                <input asp-for="About_View_M01.input01" required />
            </div>

        }
        <div class="status-label">
            @Model.About_View_M01.StatusMessage01
        </div>
        @if (Model.About_View_M01.ShowInput03)
        {
            <div class="contact-card">
                <label>@Model.About_View_M01.label02</label>
                <input asp-for="About_View_M01.input02" required />
            </div>

        }
        <div class="status-label">
            @Model.About_View_M01.StatusMessage02
        </div>
        @if (Model.About_View_M01.ShowInput04)
        {
            <div class="contact-card">
                <label>@Model.About_View_M01.label03</label>
                <input asp-for="About_View_M01.input03" required />
            </div>

        }
        <div class="status-label">
            @Model.About_View_M01.StatusMessage03
        </div>
        @if (Model.About_View_M01.ShowInput05)
        {
            <div class="contact-card">
                <label>@Model.About_View_M01.label04</label>
                <input asp-for="About_View_M01.input04" required />
            </div>

        }
        <div class="status-label">
            @Model.About_View_M01.StatusMessage04
        </div>
        @if (Model.About_View_M01.ShowInput06)
        {
            <div class="cta">
                <button type="submit" asp-page-handler="ok">
                    ⚡ OK ⚡
                </button>
            </div>
        }
        <div class="status-label">
            @Model.About_View_M01.StatusMessage05
        </div>
        <div class="cta">
            <button type="submit" asp-page-handler="back">
                ⚡ BACK ⚡
            </button>
        </div>
        @if (Model.About_View_M01.ShowInput07)
        {
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />

                <title>Download Easy Callender</title>

                <link href="~/css/site01.css" rel="stylesheet" />
            </head>

            <body>

                <section class="download-section">

                    <h1>Easy Callender Mobile App</h1>

                    <p>
                        Download the Easy Callender Android application
                        directly to your mobile device.
                    </p>

                    <a href="~/downloads/EasyCallender.apk" class="download-button" download="EasyCallender.apk">

                        Download Android App
                    </a>

                    <p class="download-note">
                        Android APK • Direct Download
                    </p>
                </section>
            </body>
        }
    </form>
    <footer>
        © 2026 EASY CALLENDER
    </footer>
@page
@model EASYPROJECT01.EASY_WEBB.Pages.Index
@{
    ViewData["Title"] = "Easy Callender";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="@Url.Content(Model.css01)" rel="stylesheet" />
</head>
<body>
    <div class="halftone">
        <h1>EASY CALLENDER</h1>
        <div class="tagline">
            💥 Easy callender projects 💥
        </div>
        <form method="post">
            @for (int i = 0; i < Model.button_text.Length; i++)
            {
                <div class="cta">
                    <button type="submit" asp-page-handler="Navigate" name="destination" value="@Model.button_destinations[i]">
                        @Model.button_text[i]
                    </button>
                </div>
            }
        </form>
        <footer>
            © 2026 EASY CALLENDER
        </footer>
    </div>
</body>
</html>
